*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx

# Claude Code transient hook state (nav-compile gate, gradle output log)
.claude/state/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# JVM heap dumps
*.hprof

# Generated baseline profiles
**/generated/baselineProfiles/

# Firebase config files (distributed via CI secrets)
**/google-services.json
**/GoogleService-Info.plist

# Keystores and signing
*.keystore
*.jks

# Tracey crash dumps (may contain PII hashes)
tracey-dumps/
/firebase-debug.log

# Source video files (too large for git, only GIFs tracked)
assets/*.mov

# Emulator/simulator captures (local-dev only, not portfolio source)
screenshots/

# Codex review raw transcripts (large; the verified summary .md is tracked instead)
.claude/codex-reviews/raw/
